#!/data/data/com.termux/files/usr/bin/bash

VERSION="1.0.0"

cyan='\033[1;36m'
green='\033[1;32m'
yellow='\033[1;33m'
red='\033[1;31m'
reset='\033[0m'

banner() {
    clear
    echo -e "${cyan}"
    echo "╔══════════════════════════════╗"
    echo "║       KAWAKI CLI ⚡          ║"
    echo "║       Termux Utility         ║"
    echo "╚══════════════════════════════╝"
    echo -e "${reset}"
    echo "Version: $VERSION"
    echo
}

pause() {
    echo
    read -rp "Appuie sur Entrée pour continuer..."
}

device_info() {
    banner
    echo -e "${yellow}📱 INFORMATIONS APPAREIL${reset}"
    echo
    echo "Android : $(getprop ro.build.version.release)"
    echo "Modèle  : $(getprop ro.product.model)"
    echo "Marque  : $(getprop ro.product.brand)"
    echo "Arch    : $(dpkg --print-architecture)"
    echo
    echo -e "${green}💾 STOCKAGE${reset}"
    df -h "$PREFIX" | tail -1
    pause
}

network_info() {
    banner
    echo -e "${yellow}🌐 RÉSEAU${reset}"
    echo
    echo "IP locale :"
    ip addr show 2>/dev/null | grep "inet " | grep -v "127.0.0.1" | head -3
    echo
    echo "Test Internet :"
    if ping -c 1 -W 2 google.com >/dev/null 2>&1; then
        echo -e "${green}✓ Connexion Internet OK${reset}"
    else
        echo -e "${red}✗ Pas de connexion Internet${reset}"
    fi
    pause
}

battery_info() {
    banner
    echo -e "${yellow}🔋 BATTERIE${reset}"
    echo
    if command -v termux-battery-status >/dev/null 2>&1; then
        termux-battery-status
    else
        echo "Installe Termux:API puis lance :"
        echo "pkg install termux-api"
    fi
    pause
}

update_tool() {
    banner
    echo -e "${yellow}🔄 MISE À JOUR${reset}"
    echo
    if [ -d ".git" ]; then
        git pull
    else
        echo "Lance cet outil depuis le dossier cloné depuis GitHub."
    fi
    pause
}

while true; do
    banner
    echo "[1] 📱 Informations du téléphone"
    echo "[2] 🌐 Informations réseau"
    echo "[3] 🔋 Batterie"
    echo "[4] 🔄 Mettre à jour"
    echo "[5] ❌ Quitter"
    echo
    read -rp "Choisis une option : " choice

    case "$choice" in
        1) device_info ;;
        2) network_info ;;
        3) battery_info ;;
        4) update_tool ;;
        5) echo -e "${green}À bientôt 👋${reset}"; exit 0 ;;
        *) echo -e "${red}Option invalide.${reset}"; sleep 1 ;;
    esac
done
